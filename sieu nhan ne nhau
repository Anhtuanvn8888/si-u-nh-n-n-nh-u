/* Keep the joke bubble away from the avatar face. */
.showcase-bubble{left:0;right:auto;top:3px;transform:rotate(-7deg);max-width:118px;}

/* V2.2: End screen is intentionally compact: no gift shop, no extra choice. */
.gold-hud{font-size:11px;color:#ffde6b;font-weight:900;margin-top:3px;white-space:nowrap;text-shadow:0 1px 2px #000}
.home-verdict{width:100%;border:2px solid #ffdd6d;border-radius:13px;background:#10274dec;color:#ffeaa7;text-align:center;font-size:13px;font-weight:950;padding:11px 9px;line-height:1.35}
.home-verdict.forgiven{background:#124f4aee;border-color:#80e5b1;color:#e6ffed}
.home-verdict.pinched{background:#6b1c2aee;border-color:#ff9d85;color:#ffeded}
.wife-mood{position:absolute;right:7%;top:4%;z-index:4;font-size:37px;filter:drop-shadow(0 3px 1px #472b38)}
.wife-scene.cash-forgiven{border-color:#ffe45b;box-shadow:0 5px #b68d2b,0 0 20px #ffe45baa}
.wife-scene.ear-pinched{animation:earPinch .18s ease-in-out 4}
@keyframes earPinch{0%,100%{transform:translateX(0)}50%{transform:translateX(4px)}}
/* The main artwork now gets room on short phones as well. */
.gameover{gap:8px;padding-top:calc(env(safe-area-inset-top) + 7px);padding-bottom:calc(env(safe-area-inset-bottom) + 10px)}
.gameover .wife-scene{height:clamp(210px,34vh,300px)}
.gameover .big-btn{padding:12px}
.gameover .menu-actions{margin-top:0}
