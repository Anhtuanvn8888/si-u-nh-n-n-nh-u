.showcase img{height:100%;width:auto;object-fit:contain;filter:drop-shadow(0 0 15px #fbca68a3);animation:mascotFloat 2.4s ease-in-out infinite alternate}
.showcase-bubble{position:absolute;right:0;top:12px;max-width:130px;transform:rotate(7deg);background:#fff7d8;color:#ae2628;border:2px solid #a52c2e;border-radius:16px 16px 16px 0;padding:7px 9px;font-size:12px;font-weight:1000;text-align:center;box-shadow:0 4px #111b43}
@keyframes mascotFloat{from{transform:translateY(3px) rotate(-3deg)}to{transform:translateY(-5px) rotate(2deg)}}
.avatar-card{background:linear-gradient(140deg,#112a60e8,#10204ce8);border:2px solid #7cb8ff;box-shadow:0 5px #060e32,0 0 18px #6fcbff45;position:relative;z-index:1}
.avatar-preview{background:radial-gradient(#f9ed9d,#ffb83b);border:3px solid #fff0b0;box-shadow:0 4px #b14e17,0 0 14px #ffd547c0}
.big-btn{background:linear-gradient(#fff68b,#ffc930 45%,#ff8d18);border:2px solid #fff5c3;color:#642414;text-shadow:0 1px #fff2ad;box-shadow:0 5px #b34a14,0 0 19px #f6b14673;letter-spacing:-.01em}
.outline-btn{background:linear-gradient(145deg,#28539aeb,#102557ed);border:1.5px solid #93caff;box-shadow:0 3px #07122e}
.rules{grid-template-columns:repeat(2,1fr);}
.rules span{background:linear-gradient(145deg,#0c2b61ed,#14234be8);border:1px solid #649fe9;box-shadow:inset 0 1px #ffffff23}
.rules span:last-child{grid-column:1/-1}
.gameover{background:radial-gradient(ellipse at 50% 40%,#e16c5540,transparent 60%),linear-gradient(#0c1d46f5,#160f33f3)}
.result-head span{font-size:clamp(24px,6.8vw,36px);color:#ffe85b;letter-spacing:-.025em;-webkit-text-stroke:.5px #98231f;text-shadow:0 3px #bd2f24,0 5px #64202a,0 0 10px #ffbb6177}
.wife-scene{height:clamp(230px,39vh,360px);border:4px solid #ffe49f;border-radius:19px;box-shadow:0 6px #893d2e,0 0 19px #f8b94855;background-size:cover;background-position:center}
.result-card{background:linear-gradient(125deg,#071e4efa,#143b79f2);border:2px solid #ffcd4d;box-shadow:inset 0 1px #ffffff59,0 5px #0a1233}
.result-row strong{color:#ffe775;text-shadow:0 2px #844219}
.gameover .big-btn{margin-top:3px}
